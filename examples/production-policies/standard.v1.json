{
  "id": "policy/standard",
  "version": 1,
  "quality_tier": "standard",
  "name": "Standard tier production policy (starting values)",
  "content_hash": "sha256:54d8e9ece695727db761981483f34a15230746a538504105ce70da4ae3ad779a",
  "revision": {
    "max_rounds": 3,
    "max_patches_per_round": 6,
    "max_scene_rewrites": 2,
    "per_span_attempts": 2,
    "smoke_after_patches": 3,
    "regression_tolerance_points": 3
  },
  "candidates": {
    "chapter_candidates": 1,
    "concept_candidates": 2,
    "arc_candidates": 2,
    "early_stop_margin_points": 6,
    "judge_families_differ_from_writer": true,
    "tie_fallback_ladder_authorized": true,
    "selection_schedule": "stable_slot_single_elimination"
  },
  "gates": {
    "dimensions": {
      "prose": {
        "min_score": 78,
        "judge_weight": 0.6
      },
      "structure": {
        "min_score": 78,
        "judge_weight": 0.65
      },
      "genre": {
        "min_score": 72,
        "judge_weight": 0.8
      },
      "voice": {
        "min_score": 76,
        "judge_weight": 0.7
      }
    },
    "blocking_max": 0,
    "major_max": 0,
    "judge_confidence_caps": {
      "minor_below": 0.5,
      "note_below": 0.3
    },
    "drift_flag_scene_repair_ratio": 0.3,
    "drift_flag_min_confidence": 0.7,
    "chapter_regenerate_ratio": 0.4
  },
  "context": {
    "previous_tail_words": 400,
    "previous_tail_floor_words": 250,
    "previous_tail_extend_to_scene_below_words": 600,
    "active_constraints_cap_tokens": 1200,
    "writer_input_budget_tokens": 24000,
    "l1_summary_max_words": 120,
    "input_budget_tokens": {
      "pack.chapter_planner": 14000,
      "pack.continuity_checker": 20000,
      "pack.extractor": 18000
    }
  },
  "extraction": {
    "passes": 2,
    "single_source_min_confidence": 0.8,
    "fuzzy_anchor_min_ratio": 0.98,
    "major_unresolved_blocks_commit": true,
    "adjudicate_conflicts": true
  },
  "output_language": {
    "language": "en",
    "min_english_confidence": 0.99,
    "regenerate_once_then_reroute": true
  },
  "length": {
    "warn_tolerance_ratio": 0.12,
    "fail_tolerance_ratio": 0.2
  },
  "override_matrix": {
    "never": [
      "non_english_output",
      "truncated_output",
      "invalid_structured_output",
      "format_drift",
      "content_restriction",
      "evidence_integrity",
