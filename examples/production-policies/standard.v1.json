      "timeline_error",
      "requirement_violation",
      "forbidden_development"
    ],
    "reviewer": [
      "register_error",
      "address_term_error",
      "voice_drift",
      "western_novel_drift",
      "serial_drift",
      "literary_drift",
      "translation_like_english",
      "weak_ending",
      "weak_pacing",
      "late_hook",
      "excessive_exposition",
      "repeated_paragraph",
      "repeated_scene",
      "repetitive_arc",
      "payoff_without_setup",
      "promise_forgotten",
      "length_out_of_range",
      "numeric_inconsistency",
      "unapproved_untranslated_term",
      "terminology_violation",
      "naming_registry_violation",
      "relationship_inconsistency",
      "character_inconsistency",
      "injury_forgotten",
      "inventory_impossible",
      "resource_impossible",
      "rank_incorrect",
      "location_error",
      "power_rule_violation",
