  "calibration": {
    "status": "uncalibrated",
    "notes": "Starting values consolidated from the planning package (ADR-0041). Revision limit 3 rounds resolves the former 2-vs-3 disagreement in favor of the evaluation pipeline. Thresholds are uncalibrated until the contrast-set calibration round (ADR-0029)."
  }
